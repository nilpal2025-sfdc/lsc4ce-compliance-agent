<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Full access to Compliance Framework objects and fields</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Compliance Framework Admin</label>

    <!-- Apex Class Access -->
    <classAccesses>
        <apexClass>ComplianceScriptService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>ComplianceFlowService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>ComplianceRuleEngine</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>ComplianceValidationService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>FlowValidationResult</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>ComplianceValidationResult</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>ComplianceValidationController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>ComplianceReviewParser</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <!-- Compliance Rule Object -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>true</modifyAllRecords>
        <object>Compliance_Rule__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Compliance Alert Object -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>true</modifyAllRecords>
        <object>Compliance_Alert__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Compliance Audit Log Object -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>true</modifyAllRecords>
        <object>Compliance_Audit_Log__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Non-required Compliance Rule Fields -->
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Rule__c.Description__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Rule__c.Keywords__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Rule__c.Pattern__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Rule__c.Remediation_Message__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Rule__c.Is_Active__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- Non-required Compliance Alert Fields -->
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Alert__c.Rule__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Alert__c.Original_Value__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Alert__c.Matched_Content__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Alert__c.User__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Alert__c.Resolution_Notes__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- Non-required Compliance Audit Log Fields -->
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Audit_Log__c.Rule__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Audit_Log__c.User__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Audit_Log__c.Execution_Time_Ms__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Compliance_Audit_Log__c.Details__c</field>
        <readable>true</readable>
    </fieldPermissions>
</PermissionSet>
