    <constants>
        <name>RetrieverID</name>
        <dataType>String</dataType>
        <value>
            <stringValue>File_LSC_Field_Sales_Compliance_Library_1Cx_aEre37a6895</stringValue>
        </value>
    </constants>
    <decisions>
        <name>Check_Compliance_Status</name>
        <label>Check Compliance Status</label>
        <locationX>176</locationX>
        <locationY>600</locationY>
        <description>Route based on compliance evaluation result</description>
        <defaultConnector>
            <targetReference>FinalFormattedOutputResult</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Compliant</defaultConnectorLabel>
        <rules>
            <name>Non_Compliant</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ComplianceStatus</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Compliant</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Compliance_Alert</targetReference>
            </connector>
            <label>Non-Compliant</label>
        </rules>
    </decisions>
    <formulas>
        <name>AuditResult</name>
        <dataType>String</dataType>
        <description>Maps ComplianceStatus to Pass/Fail for audit log</description>
        <expression>IF({!ComplianceStatus} = "Compliant", "Pass", "Fail")</expression>
    </formulas>
    <formulas>
        <name>AuditDetails</name>
        <dataType>String</dataType>
        <description>Audit details combining compliance check outputs</description>
        <expression>"Status: " &amp; {!ComplianceStatus} &amp; " | Risk: " &amp; IF(ISBLANK({!RiskLevel}), "N/A", {!RiskLevel}) &amp; " | Violation: " &amp; IF(ISBLANK({!DetectedViolation}), "None", LEFT({!DetectedViolation}, 500)) &amp; " | Input: " &amp; LEFT({!VoiceTextUtterance}, 500)</expression>
    </formulas>
