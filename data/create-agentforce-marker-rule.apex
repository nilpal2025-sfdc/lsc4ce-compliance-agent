// Create "Agentforce Evaluation" marker rule for LLM-based compliance alerts
// This rule is not used for actual validation - it's a marker for reporting

System.debug('====== CREATE AGENTFORCE EVALUATION MARKER RULE ======');

// Check if rule already exists
List<Compliance_Rule__c> existingRules = [
    SELECT Id, Name__c
    FROM Compliance_Rule__c
    WHERE Name__c = 'Agentforce Evaluation'
    LIMIT 1
];

if (!existingRules.isEmpty()) {
    System.debug('⚠️  Rule already exists with ID: ' + existingRules[0].Id);
    System.debug('Rule ID (for flow): ' + existingRules[0].Id);
} else {
    // Create the marker rule
    Compliance_Rule__c agentforceRule = new Compliance_Rule__c(
        Name__c = 'Agentforce Evaluation',
        Description__c = 'Marker rule for compliance alerts generated by Agentforce LLM evaluation. This rule is not used for validation - it serves as a label for reporting and identification purposes.',
        Rule_Type__c = 'Pattern_Match',  // Using Pattern_Match type (LLM_Based not in picklist)
        Is_Active__c = false,  // Not used for actual validation
        Target_Object__c = 'ProviderVisit',
        Target_Field__c = 'NextProviderVisitObjective',
        Action__c = 'Log',  // Passive action since not used for validation
        Severity__c = 'Medium'  // Default, actual severity comes from LLM
    );

    try {
        insert agentforceRule;
        System.debug('✅ Successfully created Agentforce Evaluation rule');
        System.debug('Rule ID (for flow): ' + agentforceRule.Id);
        System.debug('Rule Name: ' + agentforceRule.Name__c);
    } catch (Exception e) {
        System.debug('❌ Failed to create rule: ' + e.getMessage());
    }
}

System.debug('====== COMPLETE ======');
