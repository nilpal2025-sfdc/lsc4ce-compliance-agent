force-app/main/default/genAiPlannerBundles/
force-app/main/default/bots/

# Prompt templates with org-specific data providers (Einstein Search indexes, file libraries).
# Deploy Visit_Note_Mapper separately after AccountAProductNames flow is active.
# Compliance_Check requires a Data Library with uploaded SOP documents.
force-app/main/default/genAiPromptTemplates/Compliance_Check.genAiPromptTemplate-meta.xml

# Flow that depends on Compliance_Check prompt template (excluded above).
# Deploy after Compliance_Check template is configured in the target org.
force-app/main/default/flows/Visit_Logging_Compliance_Check.flow-meta.xml